#
# http://router/ opens Supa Cudy instead of LuCI. uhttpd tries the index
# names in order in every directory, so /www/supacudy-start.html wins at
# the top while LuCI's /www/index.html stays untouched for upgrades.

if [ -z "$(uci -q get uhttpd.main.index_page)" ]; then
	uci add_list uhttpd.main.index_page='supacudy-start.html'
	uci add_list uhttpd.main.index_page='index.html'
	uci commit uhttpd
fi

exit 0
